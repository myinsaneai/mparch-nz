rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Replace with the single admin account's email (same as VITE_ADMIN_EMAIL).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'axces2000@yahoo.com';
    }

    // Site settings (name, menus, theme): public read, admin write.
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Projects: visitors only see published ones, admin sees and edits everything.
    match /projects/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Contact form submissions: anyone can create (validated), only admin reads/deletes.
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.email.size() <= 320
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }
  }
}
